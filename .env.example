# ===== Public service configuration =====
GROONA_PUBLIC_BASE_URL=https://www.YOUR_DOMAIN.kr
GROONA_API_BASE_URL=https://api.YOUR_DOMAIN.kr
GROONA_DOMAIN=www.YOUR_DOMAIN.kr

# ===== Public data =====
DATA_GO_KR_SERVICE_KEY=
ULSAN_THEMEPARK_API_URL=
CHANGWON_SCIENCE_API_URL=
GYEONGNAM_SAFETY_API_URL=

# ===== Auth / security =====
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
DATABASE_PATH=/var/lib/groona/groona4.db

# ===== Native app association =====
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
ANDROID_SHA256_FINGERPRINT=YOUR_PLAY_APP_SIGNING_SHA256

# ===== Optional external services =====
KAKAO_REST_API_KEY=
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=

# Mobile build-time
EXPO_PUBLIC_API_BASE_URL=https://api.YOUR_DOMAIN.kr
EXPO_PUBLIC_WEB_BASE_URL=https://www.YOUR_DOMAIN.kr
